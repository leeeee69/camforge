          若改用 insert_dylib / DYLD 方式，此 plist 不参与，进程 guard 在 CFHooks.m 里兜底。
        -->
        <key>Bundles</key>
        <array>
            <string>com.ss.iphone.ugc.Aweme</string>
        </array>
    </dict>
</dict>
</plist>
